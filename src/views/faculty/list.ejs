<%- include('../partials/header', { title }) %>

<main>
    <h1>Faculty Directory</h1>

    <p>Browse our faculty members and view their contact information.</p>

    <label for="sort">Sort faculty by:</label>
    <select id="sort" onchange="window.location.href='/faculty?sort=' + this.value">
        <option value="name" <%= sortBy === 'name' ? 'selected' : '' %>>Name</option>
        <option value="department" <%= sortBy === 'department' ? 'selected' : '' %>>Department</option>
        <option value="title" <%= sortBy === 'title' ? 'selected' : '' %>>Title</option>
    </select>

    <section>
        <% facultyList.forEach(member => { %>
            <article>
                <h2>
                    <a href="/faculty/<%= member.id %>">
                        <%= member.name %>
                    </a>
                </h2>

                <p><strong>Department:</strong> <%= member.department %></p>
                <p><strong>Title:</strong> <%= member.title %></p>
            </article>
        <% }) %>
    </section>
</main>

<%- include('../partials/footer') %>